{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lilyco",
  "version": "0.1.0",
  "identifier": "app.lilyco.android",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lilyco",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1 http://localhost; frame-src 'self' http://127.0.0.1 http://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "lilyco 移动端（lycodl 视频下载）",
    "longDescription": "把 lilyco CLI 作为 sidecar 带进 App，lycodl 作首个消费方：自带 Termux python3 + ffmpeg + yt-dlp，WebView 打开 lycodl 控制台。",
    "externalBin": [
      "binaries/lycodl"
    ],
    "resources": [
      "resources/runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
